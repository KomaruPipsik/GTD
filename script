-- Безопасное получение персонажа и HumanoidRootPart
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    return char, hrp, hum
end

-- Имитация нажатия клавиши (FireServer не нужен — работаем на клиенте)
local function pressE()
    -- Используем VirtualInputManager если доступен (Studio), иначе эмуляция через UIS
    local via = game:GetService("VirtualInputManager")
    if via then
        via:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(0.05)
        via:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
end

-- Получаем границы (BoundingBox) модели DistanceFade
local function getDistanceFadeBounds()
    local map   = workspace:FindFirstChild("Map")
    if not map then return nil, nil end
    local model = map:FindFirstChild("Model")
    if not model then return nil, nil end
    local df    = model:FindFirstChild("DistanceFade")
    if not df   then return nil, nil end
    -- Вычисляем AABB модели
    local minV, maxV
    for _, part in ipairs(df:GetDescendants()) do
        if part:IsA("BasePart") then
            local s = part.Size / 2
            local cf = part.CFrame
            local corners = {
                cf * Vector3.new( s.X,  s.Y,  s.Z),
                cf * Vector3.new(-s.X,  s.Y,  s.Z),
                cf * Vector3.new( s.X, -s.Y,  s.Z),
                cf * Vector3.new(-s.X, -s.Y,  s.Z),
                cf * Vector3.new( s.X,  s.Y, -s.Z),
                cf * Vector3.new(-s.X,  s.Y, -s.Z),
                cf * Vector3.new( s.X, -s.Y, -s.Z),
                cf * Vector3.new(-s.X, -s.Y, -s.Z),
            }
            for _, c in ipairs(corners) do
                if not minV then
                    minV = c; maxV = c
                else
                    minV = Vector3.new(math.min(minV.X, c.X), math.min(minV.Y, c.Y), math.min(minV.Z, c.Z))
                    maxV = Vector3.new(math.max(maxV.X, c.X), math.max(maxV.Y, c.Y), math.max(maxV.Z, c.Z))
                end
            end
        end
    end
    return minV, maxV
end

-- Зажим вектора внутри AABB
local function clampToBounds(pos, minV, maxV)
    if not minV or not maxV then return pos end
    return Vector3.new(
        math.clamp(pos.X, minV.X, maxV.X),
        math.clamp(pos.Y, minV.Y, maxV.Y),
        math.clamp(pos.Z, minV.Z, maxV.Z)
    )
end

-- Безопасное перемещение персонажа (с ограничением по DistanceFade)
local function safeTeleport(targetPos, useBounds)
    local _, hrp, _ = getCharacter()
    if not hrp then return end
    local finalPos = targetPos
    if useBounds then
        local minV, maxV = getDistanceFadeBounds()
        finalPos = clampToBounds(targetPos, minV, maxV)
    end
    hrp.CFrame = CFrame.new(finalPos)
end

-- ════════════════════════════════════════════════
--  2. СИСТЕМА БЕЗОПАСНОСТИ В ЗОНЕ (Area Constraint)
-- ════════════════════════════════════════════════

local DANGER_ENEMIES = {
    "enemy_aa_king_octopus",
    "enemy_aa_moth_overlord",
    "enemy_aa_snail_king",
}

-- Набор имён врагов для быстрой проверки
local dangerSet = {}
for _, name in ipairs(DANGER_ENEMIES) do dangerSet[name] = true end

local function handleDangerEnemy(enemy)
    -- Защита: сдвинуть персонажа в безопасную точку внутри DistanceFade
    if not Enabled then return end
    local _, hrp, _ = getCharacter()
    if not hrp then return end
    setStatus("⚠ Danger! Evading " .. enemy.Name)

    local minV, maxV = getDistanceFadeBounds()
    if not minV then
        -- Нет DistanceFade — просто поднимаем выше
        safeTeleport(hrp.Position + Vector3.new(0, 20, 0), false)
        return
    end

    -- Попытка уйти подальше от врага в пределах зоны
    local enemyPos  = enemy.PrimaryPart and enemy.PrimaryPart.Position or hrp.Position
    local direction = (hrp.Position - enemyPos)
    if direction.Magnitude < 0.1 then direction = Vector3.new(1, 0, 0) end
    direction = direction.Unit * 30

    local safePos = clampToBounds(hrp.Position + direction, minV, maxV)

    -- Временно отключаем CanTouch у всех BasePart персонажа
    local char = LocalPlayer.Character
    local origCanTouch = {}
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                origCanTouch[part] = part.CanTouch
                part.CanTouch = false
            end
        end
    end

    hrp.CFrame = CFrame.new(safePos)
    task.wait(1.5)

    -- Восстанавливаем CanTouch
    if char then
        for part, val in pairs(origCanTouch) do
            if part and part.Parent then
                part.CanTouch = val
            end
        end
    end
    setStatus("running")
end

local function startAreaConstraint()
    local map = workspace:WaitForChild("Map", 30)
    if not map then return end
    local entities = map:WaitForChild("Entities", 30)
    if not entities then return end

    -- Слушаем добавление новых детей
    local conn = entities.ChildAdded:Connect(function(child)
        if not Enabled then return end
        if dangerSet[child.Name] then
            task.spawn(handleDangerEnemy, child)
        end
    end)

    -- Проверяем уже существующих
    for _, child in ipairs(entities:GetChildren()) do
        if dangerSet[child.Name] and Enabled then
            task.spawn(handleDangerEnemy, child)
        end
    end

    -- Сохраняем соединение для отмены
    table.insert(ActiveThreads, conn)
end

-- ════════════════════════════════════════════════
--  3. АВТО-ФИНИШ (Multi-level Readiness Check)
-- ════════════════════════════════════════════════

local function startAutoFinish()
    local map = workspace:WaitForChild("Map", 30)
    if not map then return end
    local loadedGame = map:WaitForChild("LoadedGame", 30)
    if not loadedGame then return end
    local finishFolder = loadedGame:WaitForChild("Finish", 30)
    if not finishFolder then return end
    local finishObj = finishFolder:WaitForChild("Finish", 30)
    if not finishObj then return end

    -- Ждём появления Model с MeshPart и MeshPart2 внутри finishObj
    local function checkModel(model)
        if not model:IsA("Model") then return false end
        local hasMesh1 = model:FindFirstChild("MeshPart")
        local hasMesh2 = model:FindFirstChild("MeshPart2")
        return hasMesh1 ~= nil and hasMesh2 ~= nil
    end

    local function onChildAdded(child)
        if not Enabled then return end
        if checkModel(child) then
            setStatus("Finish ready — teleporting")
            -- Целевая позиция — позиция объекта Finish
            local targetPos
            if finishObj:IsA("BasePart") then
                targetPos = finishObj.Position
            elseif finishObj:IsA("Model") and finishObj.PrimaryPart then
                targetPos = finishObj.PrimaryPart.Position
            else
                local firstPart = finishObj:FindFirstChildWhichIsA("BasePart")
                targetPos = firstPart and firstPart.Position or Vector3.new(0, 0, 0)
            end
            safeTeleport(targetPos, false)
        end
    end

    -- Уже загруженные
    for _, child in ipairs(finishObj:GetChildren()) do
        if checkModel(child) and Enabled then
            onChildAdded(child)
            break
        end
    end

    local conn = finishObj.ChildAdded:Connect(onChildAdded)
    table.insert(ActiveThreads, conn)
end

-- ════════════════════════════════════════════════
--  4а. ОБРАБОТКА АССЕТОВ — Unit Pump
-- ════════════════════════════════════════════════

local function handleUnitPump(unitPump)
    if not Enabled then return end
    local _, hrp, _ = getCharacter()
    if not hrp then return end

    setStatus("Moving to unit_pump")
    local pumpPos
    if unitPump:IsA("BasePart") then
        pumpPos = unitPump.Position
    elseif unitPump:IsA("Model") and unitPump.PrimaryPart then
        pumpPos = unitPump.PrimaryPart.Position
    else
        local p = unitPump:FindFirstChildWhichIsA("BasePart")
        pumpPos = p and p.Position or hrp.Position
    end

    safeTeleport(pumpPos + Vector3.new(0, 3, 3), false)
    setStatus("Interacting with unit_pump (3s)")

    -- Цикл взаимодействия 3 секунды
    local t = 0
    while t < 3 and Enabled do
        pressE()
        task.wait(0.2)
        t += 0.2
    end
    setStatus("unit_pump done")
end

-- ════════════════════════════════════════════════
--  4б. ОБРАБОТКА АССЕТОВ — Fence Barrier
-- ════════════════════════════════════════════════

local function handleFenceBarrier()
    if not Enabled then return end
    local _, hrp, _ = getCharacter()
    if not hrp then return end

    setStatus("FenceBarrier detected — lifting up")

    -- Поднять персонажа на 15 studs выше
    local newPos = hrp.Position + Vector3.new(0, 15, 0)
    safeTeleport(newPos, false)

    -- Создать временную платформу под персонажем
    if TempPlatform and TempPlatform.Parent then
        TempPlatform:Destroy()
    end
    local platform = Instance.new("Part")
    platform.Name             = "TempPlatform"
    platform.Size             = Vector3.new(6, 0.5, 6)
    platform.Anchored         = true
    platform.CanCollide       = true
    platform.BrickColor       = BrickColor.new("Bright yellow")
    platform.Transparency     = 0.5
    platform.CFrame           = CFrame.new(newPos + Vector3.new(0, -2.5, 0))
    platform.Parent           = workspace
    TempPlatform              = platform

    -- Авто-удаление через 8 секунд
    task.delay(8, function()
        if platform and platform.Parent then
            platform:Destroy()
            if TempPlatform == platform then TempPlatform = nil end
        end
        setStatus("running")
    end)
end

local function startAssetsWatcher()
    local map = workspace:WaitForChild("Map", 30)
    if not map then return end
    local loadedGame = map:WaitForChild("LoadedGame", 30)
    if not loadedGame then return end
    local assets = loadedGame:WaitForChild("Assets", 30)
    if not assets then return end

    local function onAssetAdded(child)
        if not Enabled then return end
        if child.Name == "unit_pump" then
            task.spawn(handleUnitPump, child)
        elseif child.Name == "fenceBarrier" then
            task.spawn(handleFenceBarrier)
        end
    end

    -- Уже существующие
    for _, child in ipairs(assets:GetChildren()) do
        onAssetAdded(child)
    end

    local conn = assets.ChildAdded:Connect(onAssetAdded)
    table.insert(ActiveThreads, conn)
end

-- ════════════════════════════════════════════════
--  5. ЛОГИКА РАБОЧИХ ЗОН (Plots 1–20)
-- ════════════════════════════════════════════════

local PLOT_NAMES = {}
for i = 1, 20 do PLOT_NAMES[tostring(i)] = true end

local function handlePlot(plot)
    if not Enabled then return end
    setStatus("Plot '" .. plot.Name .. "' appeared — waiting 5s")
    task.wait(5)
    if not Enabled then return end

    -- Сохраняем текущую позицию
    local _, hrp, _ = getCharacter()
    if not hrp then return end
    local savedPos = hrp.Position
    setStatus("Plot: pressing E (2s) @ " .. plot.Name)

    -- Активируем цикл нажатия E на 2 секунды
    local elapsed = 0
    while elapsed < 2 and Enabled do
        pressE()
        task.wait(0.2)
        elapsed += 0.2
    end

    if not Enabled then return end

    -- Перемещение к unit_pump
    local map        = workspace:FindFirstChild("Map")
    local loadedGame = map and map:FindFirstChild("LoadedGame")
    local assets     = loadedGame and loadedGame:FindFirstChild("Assets")
    local pump       = assets and assets:FindFirstChild("unit_pump")

    if pump then
        handleUnitPump(pump)
    else
        -- Если pump ещё не загружен — ждём
        setStatus("Waiting for unit_pump...")
        if assets then
            local p = assets:WaitForChild("unit_pump", 15)
            if p and Enabled then
                handleUnitPump(p)
            end
        end
    end
end

local function startPlotsWatcher()
    local map = workspace:WaitForChild("Map", 30)
    if not map then return end
    local loadedGame = map:WaitForChild("LoadedGame", 30)
    if not loadedGame then return end
    local plots = loadedGame:WaitForChild("Plots", 30)
    if not plots then return end

    local function onPlotAdded(child)
        if not Enabled then return end
        if PLOT_NAMES[child.Name] then
            task.spawn(handlePlot, child)
        end
    end

    for _, child in ipairs(plots:GetChildren()) do
        onPlotAdded(child)
    end

    local conn = plots.ChildAdded:Connect(onPlotAdded)
    table.insert(ActiveThreads, conn)
end

