local function getHRP()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function waitFor(parent, name, timeout)
    if not parent then return nil end
    local ok, res = pcall(function()
        return parent:WaitForChild(name, timeout or 10)
    end)
    return (ok and res) or nil
end

local vim = game:GetService("VirtualInputManager")
local function pressE()
    pcall(function() vim:SendKeyEvent(true,  Enum.KeyCode.E, false, game) end)
    task.wait(0.05)
    pcall(function() vim:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
end

-- Получаем позицию любого объекта (Model / BasePart)
local function getPos(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then
        return obj.Position
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local p = obj:FindFirstChildWhichIsA("BasePart", true)
        if p then return p.Position end
    end
    return nil
end

-- ══════════════════════════════════════════════════
--  DISTANCEFADE — AABB + кэш
--  Пересчитываем один раз за сессию; сбрасываем при
--  отключении кнопки (карта может перезагрузиться).
-- ══════════════════════════════════════════════════

local cachedMinV   = nil
local cachedMaxV   = nil
local cachedCenter = nil
local boundsReady  = false

local function computeDistanceFadeBounds()
    cachedMinV   = nil
    cachedMaxV   = nil
    cachedCenter = nil
    boundsReady  = false

    local map   = workspace:FindFirstChild("Map")
    if not map then return end
    local model = map:FindFirstChild("Model")
    if not model then return end
    local df    = model:FindFirstChild("DistanceFade")
    if not df   then return end

    local function expand(part)
        if not part:IsA("BasePart") then return end
        local s  = part.Size * 0.5
        local cf = part.CFrame
        for _, sx in ipairs({-1, 1}) do
            for _, sy in ipairs({-1, 1}) do
                for _, sz in ipairs({-1, 1}) do
                    local c = (cf * CFrame.new(s.X * sx, s.Y * sy, s.Z * sz)).Position
                    if not cachedMinV then
                        cachedMinV = c
                        cachedMaxV = c
                    else
                        cachedMinV = Vector3.new(
                            math.min(cachedMinV.X, c.X),
                            math.min(cachedMinV.Y, c.Y),
                            math.min(cachedMinV.Z, c.Z)
                        )
                        cachedMaxV = Vector3.new(
                            math.max(cachedMaxV.X, c.X),
                            math.max(cachedMaxV.Y, c.Y),
                            math.max(cachedMaxV.Z, c.Z)
                        )
                    end
                end
            end
        end
    end

    -- Обходим все BasePart внутри DistanceFade
    for _, p in ipairs(df:GetDescendants()) do
        expand(p)
    end
    -- Сам DistanceFade может быть BasePart
    if df:IsA("BasePart") then expand(df) end

    if cachedMinV then
        cachedCenter = (cachedMinV + cachedMaxV) * 0.5
        boundsReady  = true
        setStatus("DistanceFade bounds computed ✓")
    else
        setStatus("WARN: DistanceFade has no BaseParts")
    end
end

-- Зажать вектор внутри AABB
local function clamp3(v, mn, mx)
    return Vector3.new(
        math.clamp(v.X, mn.X, mx.X),
        math.clamp(v.Y, mn.Y, mx.Y),
        math.clamp(v.Z, mn.Z, mx.Z)
    )
end

-- Проверить, находится ли позиция внутри AABB
local function isInsideBounds(pos)
    if not boundsReady then return true end  -- нет данных — не блокируем
    return pos.X >= cachedMinV.X and pos.X <= cachedMaxV.X
       and pos.Y >= cachedMinV.Y and pos.Y <= cachedMaxV.Y
       and pos.Z >= cachedMinV.Z and pos.Z <= cachedMaxV.Z
end

-- ══════════════════════════════════════════════════
--  ТЕЛЕПОРТ — ЕДИНАЯ ТОЧКА ВХОДА
--  Все перемещения персонажа проходят через эту
--  функцию. Позиция всегда зажимается внутри
--  DistanceFade перед применением.
-- ══════════════════════════════════════════════════

local function safeTeleport(targetPos, yOffset)
    if not targetPos then return end
    yOffset = yOffset or 3

    local hrp = getHRP()
    if not hrp then return end

    -- Добавляем вертикальный отступ чтобы не проваливаться в пол
    local desired = targetPos + Vector3.new(0, yOffset, 0)

    -- Ограничение границами DistanceFade
    local finalPos
    if boundsReady then
        finalPos = clamp3(desired, cachedMinV, cachedMaxV)
        -- Дополнительно гарантируем минимальный Y (пол зоны + зазор)
        finalPos = Vector3.new(
            finalPos.X,
            math.max(finalPos.Y, cachedMinV.Y + 2),
            finalPos.Z
        )
    else
        -- Границы не вычислены — телепортируем как есть, но логируем предупреждение
        finalPos = desired
        setStatus("WARN: bounds not ready, teleporting without clamp")
    end

    hrp.CFrame = CFrame.new(finalPos)
end

-- ══════════════════════════════════════════════════
--  2. БОССЫ — Area Constraint
-- ══════════════════════════════════════════════════

local BOSS_NAMES = {
    enemy_aa_king_octopus  = true,
    enemy_aa_moth_overlord = true,
    enemy_aa_snail_king    = true,
}

local function evadeEnemy(enemy)
    if not Enabled or evading then return end
    evading = true

    local hrp = getHRP()
    if not hrp then evading = false; return end

    setStatus("⚠ Boss: " .. enemy.Name .. " — evading")

    -- Вычисляем направление прочь от врага
    local ePos = getPos(enemy) or hrp.Position
    local dir  = hrp.Position - ePos
    if dir.Magnitude < 0.5 then
        -- Персонаж на том же месте что и враг — уходим в центр зоны
        dir = boundsReady and (cachedCenter - hrp.Position) or Vector3.new(1, 0, 0)
    end

    -- Целевая позиция — 30 studs прочь от врага
    local target = hrp.Position + dir.Unit * 30

    -- safeTeleport автоматически зажмёт позицию внутри DistanceFade
    -- yOffset = 0 чтобы не прыгать вверх без нужды
    local desired = target

    local finalPos
    if boundsReady then
        finalPos = clamp3(desired, cachedMinV, cachedMaxV)
        finalPos = Vector3.new(finalPos.X, math.max(finalPos.Y, cachedMinV.Y + 4), finalPos.Z)
    else
        -- Только подъём на месте если нет данных о зоне
        finalPos = hrp.Position + Vector3.new(0, 12, 0)
    end

    -- Временно снять CanTouch чтобы не триггерить хитбоксы при телепорте
    local char = LocalPlayer.Character
    local savedTouch = {}
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                savedTouch[p] = p.CanTouch
                p.CanTouch = false
            end
        end
    end

    hrp.CFrame = CFrame.new(finalPos)
    task.wait(2)

    -- Восстанавливаем CanTouch
    if char then
        for p, v in pairs(savedTouch) do
            if p and p.Parent then
                p.CanTouch = v
            end
        end
    end

    evading = false
    setStatus("running")
end

local function startBossWatcher(entities)
    -- Уже существующие боссы на старте
    for _, child in ipairs(entities:GetChildren()) do
        if BOSS_NAMES[child.Name] then
            task.spawn(evadeEnemy, child)
        end
    end
    -- Новые боссы
    addConn(entities.ChildAdded:Connect(function(child)
        if not Enabled then return end
        if BOSS_NAMES[child.Name] then
            task.spawn(evadeEnemy, child)
        end
    end))
end

-- ══════════════════════════════════════════════════
--  3. АВТО-ФИНИШ
--  Телепорт происходит через safeTeleport —
--  позиция Finish зажата внутри DistanceFade.
-- ══════════════════════════════════════════════════

local function startAutoFinish(loadedGame)
    local finishFolder = loadedGame:FindFirstChild("Finish")
    if not finishFolder then
        setStatus("WARN: Finish folder not found")
        return
    end

    local finishObj = finishFolder:FindFirstChild("Finish")
    if not finishObj then
        setStatus("WARN: Finish object not found")
        return
    end

    local function tryFinish(child)
        if not Enabled then return end
        if not child:IsA("Model") then return end

        local hasMesh1 = child:FindFirstChild("MeshPart")
        local hasMesh2 = child:FindFirstChild("MeshPart2")

        if hasMesh1 and hasMesh2 then
            setStatus("Finish assets loaded — teleporting to Finish")
            local pos = getPos(finishObj)
            -- safeTeleport зажмёт позицию внутри DistanceFade
            safeTeleport(pos, 3)
        end
    end

    -- Проверяем уже загруженные дочерние объекты
    for _, child in ipairs(finishObj:GetChildren()) do
        tryFinish(child)
    end

    -- Слушаем новые
    addConn(finishObj.ChildAdded:Connect(tryFinish))
end

-- ══════════════════════════════════════════════════
--  4а. unit_pump
--  Телепорт через safeTeleport — зажат в DistanceFade.
-- ══════════════════════════════════════════════════

local function handleUnitPump(pump)
    if not Enabled or pumpBusy then return end
    pumpBusy = true

    setStatus("Moving → unit_pump")
    local pos = getPos(pump)

    -- safeTeleport проверит что позиция pump внутри зоны
    -- Если pump за пределами — персонаж встанет у края границы
    safeTeleport(pos, 3)
    task.wait(0.6)

    setStatus("Interacting unit_pump (3s)")
    local elapsed = 0
    while elapsed < 3 and Enabled do
        pressE()
        task.wait(0.2)
        elapsed += 0.2
    end

    pumpBusy = false
    setStatus("unit_pump interaction done ✓")
end

-- ══════════════════════════════════════════════════
--  4б. fenceBarrier
--  Подъём +15 studs тоже проходит через safeTeleport.
--  Платформа создаётся под новой (зажатой) позицией.
-- ══════════════════════════════════════════════════

local function handleFenceBarrier()
    if not Enabled then return end
    local hrp = getHRP()
    if not hrp then return end

    setStatus("FenceBarrier detected — lifting +15 studs")

    -- Желаемая позиция: +15 studs вверх
    local desiredPos = hrp.Position + Vector3.new(0, 15, 0)

    -- Зажать внутри DistanceFade
    local finalPos
    if boundsReady then
        finalPos = clamp3(desiredPos, cachedMinV, cachedMaxV)
        -- Если зона невысокая — берём максимально возможный Y внутри зоны
        finalPos = Vector3.new(finalPos.X, math.max(finalPos.Y, cachedMinV.Y + 2), finalPos.Z)
    else
        finalPos = desiredPos
    end

    hrp.CFrame = CFrame.new(finalPos)

    -- Удаляем старую платформу если была
    if TempPlatform and TempPlatform.Parent then
        TempPlatform:Destroy()
        TempPlatform = nil
    end

    -- Создаём временную платформу СТРОГО под финальной (зажатой) позицией
    local platform        = Instance.new("Part")
    platform.Name         = "TempPlatform_Auto"
    platform.Size         = Vector3.new(8, 0.6, 8)
    platform.Anchored     = true
    platform.CanCollide   = true
    platform.Transparency = 0.4
    platform.BrickColor   = BrickColor.new("Bright yellow")
    platform.CFrame       = CFrame.new(finalPos - Vector3.new(0, 3, 0))
    platform.Parent       = workspace
    TempPlatform          = platform

    -- Автоматическое удаление платформы через 10 секунд
    task.delay(10, function()
        if platform and platform.Parent then
            platform:Destroy()
        end
        if TempPlatform == platform then
            TempPlatform = nil
        end
        if Enabled then setStatus("running") end
    end)
end

local function startAssetsWatcher(assets)
    local function onAsset(child)
        if not Enabled then return end
        if child.Name == "unit_pump" then
            task.spawn(handleUnitPump, child)
        elseif child.Name == "fenceBarrier" then
            task.spawn(handleFenceBarrier)
        end
    end

    -- Уже существующие ассеты
    for _, child in ipairs(assets:GetChildren()) do
        onAsset(child)
    end

    -- Новые ассеты
    addConn(assets.ChildAdded:Connect(onAsset))
end

-- ══════════════════════════════════════════════════
--  5. PLOTS 1–20
--  Телепорт к unit_pump проходит через handleUnitPump,
--  который вызывает safeTeleport — позиция зажата.
-- ══════════════════════════════════════════════════

local function handlePlot(plot, assets)
    -- Защита от двойного запуска одного и того же плота
    if PlotHandled[plot.Name] then return end
    PlotHandled[plot.Name] = true

    setStatus("Plot '" .. plot.Name .. "' appeared — waiting 5s")
    task.wait(5)
    if not Enabled then return end

    -- Сохраняем текущую позицию персонажа
    local hrp = getHRP()
    local savedPos = hrp and hrp.Position or nil
    if savedPos then
        setStatus("Plot '" .. plot.Name .. "' — saved pos: " .. tostring(savedPos))
    end

    -- Цикл нажатия E в течение 2 секунд
    setStatus("Plot '" .. plot.Name .. "' — pressing E (2s)")
    local elapsed = 0
    while elapsed < 2 and Enabled do
        pressE()
        task.wait(0.2)
        elapsed += 0.2
    end
    if not Enabled then return end

    -- Перемещение к unit_pump (через handleUnitPump → safeTeleport → DistanceFade clamp)
    local pump = assets:FindFirstChild("unit_pump")
    if pump then
        handleUnitPump(pump)
    else
        setStatus("Plot: unit_pump not found yet — waiting...")
        local p = waitFor(assets, "unit_pump", 20)
        if p and Enabled then
            handleUnitPump(p)
        else
            setStatus("Plot: unit_pump wait timeout")
        end
    end
end

local function startPlotsWatcher(plots, assets)
    local function onPlot(child)
        if not Enabled then return end
        local n = tonumber(child.Name)
        if n and n >= 1 and n <= 20 then
            task.spawn(handlePlot, child, assets)
        end
    end

    -- Уже существующие плоты
    for _, child in ipairs(plots:GetChildren()) do
        onPlot(child)
    end

    -- Новые плоты
    addConn(plots.ChildAdded:Connect(onPlot))
end

-- ══════════════════════════════════════════════════
--  ЗАПУСК ВСЕХ СИСТЕМ
--  Вызывается один раз при первом нажатии кнопки.
--  Сначала вычисляем границы DistanceFade, потом
--  запускаем все вотчеры — только после этого
--  любой телепорт будет безопасен.
-- ══════════════════════════════════════════════════

local function startSystems()
    if systemStarted then return end
    systemStarted = true
    setStatus("Initializing — waiting for Map...")

    task.spawn(function()
        local map = waitFor(workspace, "Map", 30)
        if not map then
            setStatus("ERROR: workspace.Map not found within 30s")
            return
        end

        -- Ждём Model и DistanceFade, потом вычисляем границы
        -- Все последующие телепорты зависят от этих данных
        local mapModel = map:FindFirstChild("Model")
        if not mapModel then
            setStatus("WARN: Map.Model not found — waiting...")
            mapModel = waitFor(map, "Model", 20)
        end

        if mapModel then
            local df = mapModel:FindFirstChild("DistanceFade")
            if not df then
                setStatus("WARN: DistanceFade not found — waiting...")
                df = waitFor(mapModel, "DistanceFade", 20)
            end
            if df then
                computeDistanceFadeBounds()
            else
                setStatus("ERROR: DistanceFade never appeared — teleports will be UNSAFE")
            end
        else
            setStatus("ERROR: Map.Model never appeared — teleports will be UNSAFE")
        end

        -- Entities / боссы
        task.spawn(function()
            local entities = map:FindFirstChild("Entities") or waitFor(map, "Entities", 30)
            if entities and Enabled then
                startBossWatcher(entities)
            elseif not entities then
                setStatus("WARN: Entities folder not found")
            end
        end)

        -- LoadedGame
        local loadedGame = map:FindFirstChild("LoadedGame") or waitFor(map, "LoadedGame", 30)
        if not loadedGame then
            setStatus("ERROR: LoadedGame not found within 30s")
            return
        end

        -- Assets
        local assets = loadedGame:FindFirstChild("Assets") or waitFor(loadedGame, "Assets", 20)
        if assets then
            startAssetsWatcher(assets)
        else
            setStatus("WARN: Assets not found — waiting longer...")
            task.spawn(function()
                local a = waitFor(loadedGame, "Assets", 60)
                if a and Enabled then
                    startAssetsWatcher(a)
                else
                    setStatus("ERROR: Assets never appeared")
                end
            end)
        end

        -- Plots
        local plots = loadedGame:FindFirstChild("Plots") or waitFor(loadedGame, "Plots", 20)
        if plots then
            if assets then
                startPlotsWatcher(plots, assets)
            else
                -- assets появится позже — ждём
                task.spawn(function()
                    local a = loadedGame:FindFirstChild("Assets") or waitFor(loadedGame, "Assets", 30)
                    if a and Enabled then
                        startPlotsWatcher(plots, a)
                    end
                end)
            end
        else
            setStatus("WARN: Plots not found — waiting longer...")
            task.spawn(function()
                local p = waitFor(loadedGame, "Plots", 60)
                local a = loadedGame:FindFirstChild("Assets") or waitFor(loadedGame, "Assets", 30)
                if p and a and Enabled then
                    startPlotsWatcher(p, a)
                end
            end)
        end

        -- AutoFinish
        startAutoFinish(loadedGame)

        if Enabled then
            setStatus("All systems active ✓")
        end
    end)
end

-- ══════════════════════════════════════════════════
--  КНОПКА TOGGLE
-- ══════════════════════════════════════════════════

ToggleBtn.MouseButton1Click:Connect(function()
    Enabled = not Enabled

    if Enabled then
        ToggleBtn.Text             = "✅  Automation: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(25, 110, 25)
        pumpBusy      = false
        evading       = false
        startSystems()
    else
        ToggleBtn.Text             = "⛔  Automation: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        disconnectAll()

        -- Очищаем временную платформу
        if TempPlatform and TempPlatform.Parent then
            TempPlatform:Destroy()
            TempPlatform = nil
        end

        -- Сбрасываем кэш границ — при следующем включении пересчитаем
        cachedMinV   = nil
        cachedMaxV   = nil
        cachedCenter = nil
        boundsReady  = false

        pumpBusy      = false
        evading       = false
        systemStarted = false

        setStatus("idle")
    end
end)
