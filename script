--  ОБРАБОТЧИКИ СОБЫТИЙ
-- ══════════════════════════════════════════

local DANGER = { enemy_aa_king_octopus=true, enemy_aa_moth_overlord=true, enemy_aa_snail_king=true }

local function onDangerEnemy(enemy)
    if not Enabled then return end
    local hrp = getHRP(); if not hrp then return end
    setStatus("Enemy! Evading " .. enemy.Name)
    local minV, maxV = getDistanceFadeBounds()

    local char = LocalPlayer.Character
    local restore = {}
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then restore[p]=p.CanTouch; p.CanTouch=false end
        end
    end

    local ePos  = pcall(getPos, enemy) and getPos(enemy) or hrp.Position
    local dir   = (hrp.Position - ePos)
    dir = ((dir.Magnitude > 0.1) and dir.Unit or Vector3.new(1,0,0)) * 30
    hrp.CFrame  = CFrame.new(clamp3(hrp.Position + dir, minV, maxV))
    task.wait(1.5)

    if char then
        for p,v in pairs(restore) do
            if p and p.Parent then p.CanTouch=v end
        end
    end
    setStatus("running")
end

local function onUnitPump(pump)
    if not Enabled then return end
    local hrp = getHRP(); if not hrp then return end
    setStatus("Moving to unit_pump")
    teleport(getPos(pump) + Vector3.new(0, 3, 3))
    local t = 0
    while t < 3 and Enabled do pressE(); task.wait(0.2); t+=0.2 end
    setStatus("unit_pump done")
end

local function onFenceBarrier()
    if not Enabled then return end
    local hrp = getHRP(); if not hrp then return end
    setStatus("fenceBarrier: lift +15")
    local up = hrp.Position + Vector3.new(0,15,0)
    hrp.CFrame = CFrame.new(up)
    if TempPlatform and TempPlatform.Parent then TempPlatform:Destroy() end
    local plat = Instance.new("Part")
    plat.Name="TempPlatform"; plat.Size=Vector3.new(6,0.5,6)
    plat.Anchored=true; plat.CanCollide=true; plat.Transparency=0.4
    plat.BrickColor=BrickColor.new("Bright yellow")
    plat.CFrame=CFrame.new(up+Vector3.new(0,-2.5,0))
    plat.Parent=workspace; TempPlatform=plat
    task.delay(8, function()
        if plat and plat.Parent then plat:Destroy() end
        if TempPlatform==plat then TempPlatform=nil end
        if Enabled then setStatus("running") end
    end)
end

local PLOTS={}; for i=1,20 do PLOTS[tostring(i)]=true end

local function onPlot(plot, assets)
    if not Enabled then return end
    setStatus("Plot '"..plot.Name.."' → wait 5s")
    task.wait(5); if not Enabled then return end
    local t=0
    setStatus("Plot '"..plot.Name.."' → pressing E 2s")
    while t<2 and Enabled do pressE(); task.wait(0.2); t+=0.2 end
    if not Enabled then return end
    local pump = assets:FindFirstChild("unit_pump")
    if pump then task.spawn(onUnitPump, pump)
    else
        setStatus("Waiting unit_pump…")
        task.spawn(function()
            local p = waitFor(assets, "unit_pump", 20)
            if p and Enabled then onUnitPump(p) end
        end)
    end
end

local function checkFinish(model)
    return model:IsA("Model")
        and model:FindFirstChild("MeshPart")  ~= nil
        and model:FindFirstChild("MeshPart2") ~= nil
end

-- ══════════════════════════════════════════
--  ГЛАВНАЯ ИНИЦИАЛИЗАЦИЯ (при нажатии ON)
-- ══════════════════════════════════════════

local function startSystems()
    task.spawn(function()
        -- ── Ждём Map ──────────────────────────────────────
        setStatus("Waiting Map…")
        local map = workspace:FindFirstChild("Map")
        if not map then
            map = waitFor(workspace, "Map", 60)
        end
        if not map then setStatus("ERROR: Map not found"); return end

        -- ── 2. Area Constraint (Entities) ─────────────────
        local entities = map:FindFirstChild("Entities")
        if entities then
            for _, c in ipairs(entities:GetChildren()) do
                if DANGER[c.Name] then task.spawn(onDangerEnemy, c) end
            end
            local conn = entities.ChildAdded:Connect(function(c)
                if Enabled and DANGER[c.Name] then task.spawn(onDangerEnemy, c) end
            end)
            table.insert(Connections, conn)
        end

        -- ── Ждём LoadedGame ───────────────────────────────
        setStatus("Waiting LoadedGame…")
        local lg = map:FindFirstChild("LoadedGame") or waitFor(map, "LoadedGame", 60)
        if not lg then setStatus("ERROR: LoadedGame not found"); return end

        -- ── 3. Auto-Finish ────────────────────────────────
        task.spawn(function()
            local finFolder = lg:FindFirstChild("Finish") or waitFor(lg, "Finish", 30)
            if not finFolder then return end
            local finObj    = finFolder:FindFirstChild("Finish") or waitFor(finFolder, "Finish", 30)
            if not finObj   then return end

            local function tryFinish(child)
                if Enabled and checkFinish(child) then
                    setStatus("Finish ready → teleport!")
                    teleport(getPos(finObj))
                end
            end
            for _, c in ipairs(finObj:GetChildren()) do tryFinish(c) end
            local conn = finObj.ChildAdded:Connect(tryFinish)
            table.insert(Connections, conn)
        end)

        -- ── 4. Assets ─────────────────────────────────────
        task.spawn(function()
            local assets = lg:FindFirstChild("Assets") or waitFor(lg, "Assets", 30)
            if not assets then return end

            local function onAsset(child)
                if not Enabled then return end
                if child.Name == "unit_pump"     then task.spawn(onUnitPump, child)
                elseif child.Name == "fenceBarrier" then task.spawn(onFenceBarrier)
                end
            end
            for _, c in ipairs(assets:GetChildren()) do onAsset(c) end
            local conn = assets.ChildAdded:Connect(onAsset)
            table.insert(Connections, conn)

            -- ── 5. Plots ──────────────────────────────────
            task.spawn(function()
                local plots = lg:FindFirstChild("Plots") or waitFor(lg, "Plots", 30)
                if not plots then return end

                local function onPlotAdded(child)
                    if Enabled and PLOTS[child.Name] then
                        task.spawn(onPlot, child, assets)
                    end
                end
                for _, c in ipairs(plots:GetChildren()) do onPlotAdded(c) end
                local conn2 = plots.ChildAdded:Connect(onPlotAdded)
                table.insert(Connections, conn2)
                setStatus("running")
            end)
        end)
    end)
end

