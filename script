local function getHRP()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local vim = game:GetService("VirtualInputManager")
local function pressE()
    pcall(function()
        vim:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

local function teleport(pos)
    local hrp = getHRP()
    if hrp then hrp.CFrame = CFrame.new(pos) end
end

local function getPos(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local p = obj:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
    end
    return Vector3.new(0,0,0)
end

-- Ждём дочерний объект без WaitForChild (polling, не бросает ошибки)
local function waitFor(parent, name, timeout)
    local t0 = os.clock()
    timeout = timeout or 30
    local child = parent:FindFirstChild(name)
    while not child and os.clock()-t0 < timeout do
        task.wait(0.3)
        child = parent:FindFirstChild(name)
    end
    return child
end

-- AABB модели DistanceFade
local function getDistanceFadeBounds()
    local map = workspace:FindFirstChild("Map")
    if not map then return nil, nil end
    local mdl = map:FindFirstChild("Model")
    if not mdl then return nil, nil end
    local df  = mdl:FindFirstChild("DistanceFade")
    if not df  then return nil, nil end
    local minV, maxV
    for _, part in ipairs(df:GetDescendants()) do
        if part:IsA("BasePart") then
            local s = part.Size/2; local cf = part.CFrame
            local corners = {
                cf*Vector3.new( s.X, s.Y, s.Z), cf*Vector3.new(-s.X, s.Y, s.Z),
                cf*Vector3.new( s.X,-s.Y, s.Z), cf*Vector3.new(-s.X,-s.Y, s.Z),
                cf*Vector3.new( s.X, s.Y,-s.Z), cf*Vector3.new(-s.X, s.Y,-s.Z),
                cf*Vector3.new( s.X,-s.Y,-s.Z), cf*Vector3.new(-s.X,-s.Y,-s.Z),
            }
            for _, c in ipairs(corners) do
                if not minV then minV=c; maxV=c else
                    minV = Vector3.new(math.min(minV.X,c.X),math.min(minV.Y,c.Y),math.min(minV.Z,c.Z))
                    maxV = Vector3.new(math.max(maxV.X,c.X),math.max(maxV.Y,c.Y),math.max(maxV.Z,c.Z))
                end
            end
        end
    end
    return minV, maxV
end

local function clamp3(pos, minV, maxV)
    if not minV then return pos end
    return Vector3.new(
        math.clamp(pos.X, minV.X, maxV.X),
        math.clamp(pos.Y, minV.Y, maxV.Y),
        math.clamp(pos.Z, minV.Z, maxV.Z)
    )
end

