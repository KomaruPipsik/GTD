-- ═══════════════════════════════════════════════════════════════
--  ГЛОБАЛЬНОЕ СОСТОЯНИЕ
-- ═══════════════════════════════════════════════════════════════

local Enabled        = false   -- главный переключатель
local HeartbeatConn  = nil     -- соединение с RunService.Heartbeat
local LastPoll       = 0       -- время последнего опроса (секунды)
local POLL_INTERVAL  = 0.5     -- интервал опроса (секунды)

-- Флаги для предотвращения повторного запуска одноразовых действий
local BossEvadeActive   = false   -- идёт уклонение от босса
local PumpBusy          = false   -- идёт взаимодействие с насосом
local BarrierHandled    = false   -- fenceBarrier уже обработан
local PlotHandled       = {}      -- plot.Name → true
local FinishDone        = false   -- Finish уже выполнен

-- Временная платформа для fenceBarrier
local TempPlatform = nil

-- Кэш границ DistanceFade
local BoundsMinV   = nil
local BoundsMaxV   = nil
local BoundsCenter = nil
local BoundsReady  = false

-- ═══════════════════════════════════════════════════════════════
--  ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
-- ═══════════════════════════════════════════════════════════════

-- Безопасно получить HumanoidRootPart
local function getHRP()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

-- Безопасно получить позицию объекта (Model или BasePart)
local function getObjPos(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then
        return obj.Position
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.Position
        end
        local bp = obj:FindFirstChildWhichIsA("BasePart", true)
        if bp then return bp.Position end
    end
    return nil
end

-- Нажатие клавиши E через VirtualInputManager
local function pressE()
    pcall(function()
        VIM:SendKeyEvent(true,  Enum.KeyCode.E, false, game)
    end)
    task.wait(0.05)
    pcall(function()
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end)
end

-- Зажать вектор внутри AABB
local function clampVec3(v, mn, mx)
    return Vector3.new(
        math.clamp(v.X, mn.X, mx.X),
        math.clamp(v.Y, mn.Y, mx.Y),
        math.clamp(v.Z, mn.Z, mx.Z)
    )
end

-- ═══════════════════════════════════════════════════════════════
--  DISTANCEFADE — вычисление AABB границ
--  Вызывается один раз при старте, результат кэшируется.
-- ═══════════════════════════════════════════════════════════════

local function computeBounds()
    BoundsMinV   = nil
    BoundsMaxV   = nil
    BoundsCenter = nil
    BoundsReady  = false

    local map = workspace:FindFirstChild("Map")
    if not map then return end

    local mapModel = map:FindFirstChild("Model")
    if not mapModel then return end

    local df = mapModel:FindFirstChild("DistanceFade")
    if not df then return end

    local function expandPart(part)
        if not part:IsA("BasePart") then return end
        local hs = part.Size * 0.5
        local cf = part.CFrame
        for _, sx in ipairs({-1, 1}) do
            for _, sy in ipairs({-1, 1}) do
                for _, sz in ipairs({-1, 1}) do
                    local corner = (cf * CFrame.new(hs.X * sx, hs.Y * sy, hs.Z * sz)).Position
                    if not BoundsMinV then
                        BoundsMinV = corner
                        BoundsMaxV = corner
                    else
                        BoundsMinV = Vector3.new(
                            math.min(BoundsMinV.X, corner.X),
                            math.min(BoundsMinV.Y, corner.Y),
                            math.min(BoundsMinV.Z, corner.Z)
                        )
                        BoundsMaxV = Vector3.new(
                            math.max(BoundsMaxV.X, corner.X),
                            math.max(BoundsMaxV.Y, corner.Y),
                            math.max(BoundsMaxV.Z, corner.Z)
                        )
                    end
                end
            end
        end
    end

    -- df сам может быть BasePart
    if df:IsA("BasePart") then expandPart(df) end

    -- Все дочерние BasePart внутри DistanceFade
    for _, desc in ipairs(df:GetDescendants()) do
        expandPart(desc)
    end

    if BoundsMinV then
        BoundsCenter = (BoundsMinV + BoundsMaxV) * 0.5
        BoundsReady  = true
        setStatus("DistanceFade bounds OK ✓")
    else
        setStatus("WARN: DistanceFade — no BaseParts found")
    end
end

-- ═══════════════════════════════════════════════════════════════
--  ЕДИНСТВЕННАЯ ТОЧКА ТЕЛЕПОРТА
--  Все перемещения персонажа идут только через эту функцию.
--  Позиция ВСЕГДА зажимается внутри DistanceFade.
-- ═══════════════════════════════════════════════════════════════

local function safeTeleport(targetPos, yOffset)
    if not targetPos then return end
    yOffset = yOffset or 3

    local hrp = getHRP()
    if not hrp then return end

    local desired = targetPos + Vector3.new(0, yOffset, 0)

    local final
    if BoundsReady then
        -- Зажимаем внутри AABB DistanceFade
        final = clampVec3(desired, BoundsMinV, BoundsMaxV)
        -- Минимальный Y = пол зоны + небольшой зазор
        final = Vector3.new(final.X, math.max(final.Y, BoundsMinV.Y + 2), final.Z)
    else
        -- Границы ещё не готовы — пробуем пересчитать на месте
        computeBounds()
        if BoundsReady then
            final = clampVec3(desired, BoundsMinV, BoundsMaxV)
            final = Vector3.new(final.X, math.max(final.Y, BoundsMinV.Y + 2), final.Z)
        else
            -- Совсем нет данных — не телепортируем, логируем
            setStatus("SKIP teleport: DistanceFade bounds unknown")
            return
        end
    end

    hrp.CFrame = CFrame.new(final)
end

-- ═══════════════════════════════════════════════════════════════
--  2. БОССЫ — уклонение с ограничением по DistanceFade
-- ═══════════════════════════════════════════════════════════════

local BOSS_SET = {
    ["enemy_aa_king_octopus"]  = true,
    ["enemy_aa_moth_overlord"] = true,
    ["enemy_aa_snail_king"]    = true,
}

local function doEvade(bossObj)
    if BossEvadeActive then return end
    BossEvadeActive = true

    local hrp = getHRP()
    if not hrp then BossEvadeActive = false; return end

    setStatus("⚠ Boss: " .. bossObj.Name .. " — evading")

    -- Временно снимаем CanTouch
    local char = LocalPlayer.Character
    local savedTouch = {}
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                savedTouch[part] = part.CanTouch
                part.CanTouch = false
            end
        end
    end

    -- Вычисляем безопасную позицию внутри DistanceFade
    local bossPos = getObjPos(bossObj) or hrp.Position
    local awayDir = hrp.Position - bossPos
    if awayDir.Magnitude < 0.5 then
        awayDir = BoundsReady and (BoundsCenter - hrp.Position) or Vector3.new(1, 0, 0)
    end

    local target = hrp.Position + awayDir.Unit * 30

    local safePos
    if BoundsReady then
        safePos = clampVec3(target, BoundsMinV, BoundsMaxV)
        safePos = Vector3.new(safePos.X, math.max(safePos.Y, BoundsMinV.Y + 4), safePos.Z)
    else
        -- Нет данных о зоне — только подъём вертикально
        safePos = hrp.Position + Vector3.new(0, 12, 0)
    end

    hrp.CFrame = CFrame.new(safePos)
    task.wait(2)

    -- Восстанавливаем CanTouch
    if char then
        for part, val in pairs(savedTouch) do
            if part and part.Parent then
                part.CanTouch = val
            end
        end
    end

    BossEvadeActive = false
    setStatus("running")
end

-- Проверка боссов: вызывается из главного цикла
local function checkBosses()
    if BossEvadeActive then return end

    local map      = workspace:FindFirstChild("Map")
    if not map then return end
    local entities = map:FindFirstChild("Entities")
    if not entities then return end

    for _, child in ipairs(entities:GetChildren()) do
        if BOSS_SET[child.Name] then
            task.spawn(doEvade, child)
            return  -- уклоняемся от первого найденного
        end
    end
end

-- ═══════════════════════════════════════════════════════════════
--  3. АВТО-ФИНИШ
--  Проверяем: внутри Finish.Finish есть Model с MeshPart и MeshPart2
-- ═══════════════════════════════════════════════════════════════

local function checkAutoFinish(loadedGame)
    if FinishDone then return end

    local finishFolder = loadedGame:FindFirstChild("Finish")
    if not finishFolder then return end

    local finishObj = finishFolder:FindFirstChild("Finish")
    if not finishObj then return end

    -- Ищем Model внутри которой есть и MeshPart и MeshPart2
    for _, child in ipairs(finishObj:GetChildren()) do
        if child:IsA("Model") then
            local hasMesh1 = child:FindFirstChild("MeshPart")
            local hasMesh2 = child:FindFirstChild("MeshPart2")
            if hasMesh1 and hasMesh2 then
                setStatus("Finish assets ready — teleporting ✓")
                local pos = getObjPos(finishObj)
                safeTeleport(pos, 3)
                FinishDone = true
                return
            end
        end
    end
end

-- ═══════════════════════════════════════════════════════════════
--  4а. UNIT PUMP — взаимодействие 3 секунды
-- ═══════════════════════════════════════════════════════════════

local function doUnitPump(pump)
    if PumpBusy then return end
    PumpBusy = true

    setStatus("Moving to unit_pump...")
    local pos = getObjPos(pump)
    safeTeleport(pos, 3)
    task.wait(0.8)   -- даём физике устаканиться

    setStatus("Interacting with unit_pump (3s)...")
    local elapsed = 0
    while elapsed < 3 and Enabled do
        pressE()
        task.wait(0.2)
        elapsed = elapsed + 0.2
    end

    PumpBusy = false
    setStatus("unit_pump done ✓")
end

-- ═══════════════════════════════════════════════════════════════
--  4б. FENCE BARRIER — подъём на 15 studs + временная платформа
-- ═══════════════════════════════════════════════════════════════

local function doFenceBarrier()
    if BarrierHandled then return end
    BarrierHandled = true

    local hrp = getHRP()
    if not hrp then return end

    setStatus("FenceBarrier — lifting +15 studs")

    -- Желаемая позиция: текущая + 15 вверх
    local desiredPos = hrp.Position + Vector3.new(0, 15, 0)

    -- Зажимаем внутри DistanceFade
    local finalPos
    if BoundsReady then
        finalPos = clampVec3(desiredPos, BoundsMinV, BoundsMaxV)
        finalPos = Vector3.new(finalPos.X, math.max(finalPos.Y, BoundsMinV.Y + 2), finalPos.Z)
    else
        finalPos = desiredPos
    end

    hrp.CFrame = CFrame.new(finalPos)

    -- Убираем старую платформу
    if TempPlatform and TempPlatform.Parent then
        TempPlatform:Destroy()
        TempPlatform = nil
    end

    -- Создаём платформу строго под финальной (зажатой) позицией
    local plat            = Instance.new("Part")
    plat.Name             = "TempPlatform_Auto"
    plat.Size             = Vector3.new(8, 0.6, 8)
    plat.Anchored         = true
    plat.CanCollide       = true
    plat.Transparency     = 0.35
    plat.BrickColor       = BrickColor.new("Bright yellow")
    plat.CFrame           = CFrame.new(finalPos - Vector3.new(0, 3.3, 0))
    plat.Parent           = workspace
    TempPlatform          = plat

    -- Авто-удаление через 10 секунд
    task.delay(10, function()
        if plat and plat.Parent then
            plat:Destroy()
        end
        if TempPlatform == plat then
            TempPlatform = nil
        end
        -- Разрешаем повторное срабатывание если барьер появится снова
        BarrierHandled = false
        if Enabled then setStatus("running") end
    end)
end

-- Проверка Assets: вызывается из главного цикла
local function checkAssets(loadedGame)
    local assets = loadedGame:FindFirstChild("Assets")
    if not assets then return end

    -- unit_pump
    local pump = assets:FindFirstChild("unit_pump")
    if pump and not PumpBusy then
        task.spawn(doUnitPump, pump)
    end

    -- fenceBarrier
    local barrier = assets:FindFirstChild("fenceBarrier")
    if barrier and not BarrierHandled then
        task.spawn(doFenceBarrier)
    end
end

-- ═══════════════════════════════════════════════════════════════
--  5. PLOTS 1–20
-- ═══════════════════════════════════════════════════════════════

local function doPlot(plot, assets)
    -- Помечаем как обработанный сразу, чтобы главный цикл не запустил снова
    PlotHandled[plot.Name] = true

    setStatus("Plot '" .. plot.Name .. "' — waiting 5 seconds...")
    task.wait(5)
    if not Enabled then return end

    -- Сохраняем текущую позицию персонажа
    local hrp = getHRP()
    local savedPos = hrp and hrp.Position or nil
    if savedPos then
        setStatus("Plot '" .. plot.Name .. "' — saved pos: " .. tostring(math.floor(savedPos.X)) .. ", " .. tostring(math.floor(savedPos.Y)) .. ", " .. tostring(math.floor(savedPos.Z)))
    end

    -- Цикл нажатия E на 2 секунды
    setStatus("Plot '" .. plot.Name .. "' — pressing E (2s)...")
    local elapsed = 0
    while elapsed < 2 and Enabled do
        pressE()
        task.wait(0.2)
        elapsed = elapsed + 0.2
    end
    if not Enabled then return end

    -- Перемещаемся к unit_pump
    local pump = assets:FindFirstChild("unit_pump")
    if pump then
        doUnitPump(pump)
    else
        -- unit_pump ещё не появился — ждём до 20 секунд
        setStatus("Plot: waiting for unit_pump...")
        local waited = 0
        while waited < 20 and Enabled do
            task.wait(0.5)
            waited = waited + 0.5
            pump = assets:FindFirstChild("unit_pump")
            if pump then break end
        end
        if pump and Enabled then
            doUnitPump(pump)
        else
            setStatus("Plot: unit_pump timeout")
        end
    end
end

-- Проверка Plots: вызывается из главного цикла
local function checkPlots(loadedGame)
    local plots = loadedGame:FindFirstChild("Plots")
    if not plots then return end

    local assets = loadedGame:FindFirstChild("Assets")
    if not assets then return end

    for _, child in ipairs(plots:GetChildren()) do
        local n = tonumber(child.Name)
        if n and n >= 1 and n <= 20 then
            if not PlotHandled[child.Name] then
                task.spawn(doPlot, child, assets)
            end
        end
    end
end

-- ═══════════════════════════════════════════════════════════════
--  ГЛАВНЫЙ ЦИКЛ ОПРОСА
--  Срабатывает каждые POLL_INTERVAL секунд пока Enabled = true.
--  Проверяет ВСЕ условия независимо — даже если объекты уже
--  существовали до включения скрипта.
-- ═══════════════════════════════════════════════════════════════

local function onHeartbeat(dt)
    if not Enabled then return end

    -- Ограничиваем частоту: не чаще раза в POLL_INTERVAL секунд
    LastPoll = LastPoll + dt
    if LastPoll < POLL_INTERVAL then return end
    LastPoll = 0

    -- Ищем корневой Map
    local map = workspace:FindFirstChild("Map")
    if not map then
        setStatus("Waiting: workspace.Map...")
        return
    end

    -- Пересчитываем границы если ещё не готовы
    if not BoundsReady then
        computeBounds()
    end

    -- 2. Проверяем боссов
    checkBosses()

    -- Ищем LoadedGame
    local loadedGame = map:FindFirstChild("LoadedGame")
    if not loadedGame then
        setStatus("Waiting: Map.LoadedGame...")
        return
    end

    -- 3. Авто-Финиш
    checkAutoFinish(loadedGame)

    -- 4. Ассеты (unit_pump + fenceBarrier)
    checkAssets(loadedGame)

    -- 5. Плоты
    checkPlots(loadedGame)
end

-- ═══════════════════════════════════════════════════════════════
--  СБРОС СОСТОЯНИЯ (при выключении)
-- ═══════════════════════════════════════════════════════════════

local function resetState()
    BossEvadeActive = false
    PumpBusy        = false
    BarrierHandled  = false
    FinishDone      = false
    PlotHandled     = {}
    LastPoll        = 0

    BoundsMinV   = nil
    BoundsMaxV   = nil
    BoundsCenter = nil
    BoundsReady  = false

    if TempPlatform and TempPlatform.Parent then
        TempPlatform:Destroy()
        TempPlatform = nil
    end
end

-- ═══════════════════════════════════════════════════════════════
--  КНОПКА TOGGLE
-- ═══════════════════════════════════════════════════════════════

ToggleBtn.MouseButton1Click:Connect(function()
    Enabled = not Enabled

    if Enabled then
        -- Включаем
        ToggleBtn.Text             = "✅  Automation: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(25, 110, 25)
        LastPoll = POLL_INTERVAL   -- чтобы первый цикл сработал немедленно

        -- Подключаем главный цикл если ещё не подключён
        if not HeartbeatConn then
            HeartbeatConn = RunService.Heartbeat:Connect(onHeartbeat)
        end

        setStatus("enabled — scanning...")
    else
        -- Выключаем
        ToggleBtn.Text             = "⛔  Automation: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

        -- Отключаем главный цикл
        if HeartbeatConn then
            HeartbeatConn:Disconnect()
            HeartbeatConn = nil
        end

        resetState()
        setStatus("idle")
    end
end)

-- ═══════════════════════════════════════════════════════════════
--  Респавн персонажа — сбрасываем флаги чтобы всё отработало
--  заново для нового персонажа
-- ═══════════════════════════════════════════════════════════════

LocalPlayer.CharacterAdded:Connect(function()
    if Enabled then
        BossEvadeActive = false
        PumpBusy        = false
        BarrierHandled  = false
        FinishDone      = false
        PlotHandled     = {}
        LastPoll        = POLL_INTERVAL
        setStatus("Character respawned — restarting scan")
    end
end)
