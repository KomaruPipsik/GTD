-- AutomationScript.lua  (LocalScript → StarterPlayerScripts)
-- Roblox Luau | v4 — архитектура на основе главного цикла опроса
-- Больше не зависит от ChildAdded для уже загруженных объектов.
-- RunService.Heartbeat → опрос каждые 0.5 сек → надёжная работа.

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local VIM        = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")

